{
  "chat.agent.enabled": false,
  "chat.editing.confirmEditRequestRemoval": false,
  "chat.editing.confirmEditRequestRetry": false,
  "workbench.settings.applyToAllProfiles": ["chat.disableAIFeatures"],
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "telemetry.editStats.enabled": false,
  "files.autoSave": "onFocusChange",
  "editor.cursorBlinking": "smooth",
  "workbench.settings.showAISearchToggle": false,
  "workbench.browser.enableChatTools": false,
  "chat.agent.maxRequests": 0,
  "chat.checkpoints.enabled": false,
  "chat.agent.sandbox.allowAutoApprove": false,
  "chat.agent.sandbox.allowUnsandboxedCommands": false,
  "chat.agent.thinking.terminalTools": false,
  "chat.math.enabled": false,
  "chat.tips.enabled": false,
  "chat.editor.claude.preferAgentHost": false,
  "chat.editor.copilotCli.hideExtensionHost": false,
  "chat.tools.terminal.enableAutoApprove": false,
  "chat.editor.localAgent.enabled": false,
  "chat.viewSessions.enabled": false,
  "chat.mcp.access": "none",
  "chat.mcp.apps.enabled": false,
  "chat.detectParticipant.enabled": false,
  "chat.implicitContext.suggestedContext": false,
  "chat.includeApplyingInstructions": false,
  "chat.useAgentSkills": false,
  "chat.useAgentsMdFile": false,
  "chat.useClaudeMdFile": false,
  "chat.useHooks": false,
  "chat.implicitContext.includeActiveEditor": false,
  "inlineChat.askInChat": false,
  "inlineChat.fixDiagnostics": false,
  "chat.disableAIFeatures": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.activateEnvironment": false,
  "settingsSync.ignoredExtensions": ["vscode.typescript-language-features"],
  "debug.breakpointsView.presentation": "tree",
  "telemetry.enableCrashReporter": false,
  "update.showReleaseNotes": true,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "search.searchView.semanticSearchBehavior": "manual",
  "search.searchView.keywordSuggestions": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.hg/store/**": true,
  },
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "editor.cursorSmoothCaretAnimation": "off",
  "terminal.integrated.gpuAcceleration": "on",
  "editor.minimap.enabled": true,
  "editor.codeLens": true,
  "update.mode": "none",
  "zig.zls.enabled": "on",
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-dark",
  "workbench.colorTheme": "Monokai",

  /* --- Minimal / Zed-like UI --- */
  "workbench.activityBar.location": "default",
  "breadcrumbs.enabled": true,
  "editor.renderLineHighlight": "none",
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.stickyScroll.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "window.menuBarVisibility": "classic",
  "workbench.layoutControl.enabled": true,
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.tabActionCloseVisibility": true,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.reduceMotion": "on",

  /* --- Editor feel --- */
  "editor.padding.top": 12,
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.2,
  "editor.fontLigatures": true,
  "editor.cursorStyle": "line-thin",
  "editor.lineNumbers": "on",

  /* --- Sidebar / tree --- */
  "workbench.tree.renderIndentGuides": "always",
  "workbench.tree.indent": 14,
  "workbench.list.openMode": "singleClick",
  "workbench.sideBar.location": "left",
  "explorer.compactFolders": false,

  /* --- Translucent Glass & Borderless UI --- */
  "workbench.colorCustomizations": {
    "editor.background": "#0d1117d0",
    "sideBar.background": "#090d12b0",
    "activityBar.background": "#090d12b0",
    "statusBar.background": "#090d12b0",
    "titleBar.activeBackground": "#090d12b0",
    "panel.background": "#0d1117d0",
    "tab.activeBackground": "#0d1117d0",
    "tab.inactiveBackground": "#090d1290",

    // Fully hide all UI border lines
    "sideBar.border": "#00000000",
    "sideBarSectionHeader.border": "#00000000",
    "sideBarTitle.border": "#00000000",
    "activityBar.border": "#00000000",
    "panel.border": "#00000000",
    "statusBar.border": "#00000000",
    "titleBar.border": "#00000000",
    "editorGroup.border": "#00000000",
    "editorGroupHeader.border": "#00000000",
    "editorGroupHeader.tabsBorder": "#00000000",
    "editorGroupHeader.tabsBackground": "#00000000",
    "tab.border": "#00000000",
    "tab.activeBorder": "#00000000",
    "tab.activeBorderTop": "#00000000",
    "tab.unfocusedActiveBorder": "#00000000",
    "tab.unfocusedActiveBorderTop": "#00000000",
    "editorOverviewRuler.border": "#00000000",
    "focusBorder": "#00000000",
    "contrastBorder": "#00000000",
    "editorWidget.border": "#00000000",
    "widget.border": "#00000000",
    "breadcrumb.background": "#00000000",

    // Soft glass scrollbars and selections
    "scrollbarSlider.background": "#ffffff10",
    "scrollbarSlider.hoverBackground": "#ffffff20",
    "scrollbarSlider.activeBackground": "#ffffff30",
    "list.activeSelectionBackground": "#ffffff14",
    "list.inactiveSelectionBackground": "#ffffff0c",
    "list.hoverBackground": "#ffffff0a",
  },

  "git.confirmSync": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "svelte.enable-ts-plugin": true,
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "/tmp/postman-collections-post-response.instructions.md": true,
    "/tmp/postman-collections-pre-request.instructions.md": true,
    "/tmp/postman-folder-post-response.instructions.md": true,
    "/tmp/postman-folder-pre-request.instructions.md": true,
    "/tmp/postman-http-request-post-response.instructions.md": true,
    "/tmp/postman-http-request-pre-request.instructions.md": true,
  },
  "workbench.editor.enablePreview": false,
  "editor.formatOnSave": true,
  "C_Cpp.default.cStandard": "gnu23",
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "C_Cpp.default.cppStandard": "c++23",
  "errorLens.enabled": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "haskell.manageHLS": "GHCup",
  "explorer.confirmDragAndDrop": false,
  "workbench.startupEditor": "none",
  "editor.fontFamily": "'Droid Sans Mono', 'JetBrainsMono Nerd Font', 'Noto Color Emoji', monospace",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrainsMono NF'",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "explorer.confirmDelete": true,
  "C_Cpp.clang_format_style": "Google",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
    },
  },
  "dart.previewFlutterUiGuides": true,
  "dart.closingLabels": true,
}
